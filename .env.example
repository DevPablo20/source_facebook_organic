# Copie para .env e preencha. .env e secrets ficam fora do git.

# Token de System User do Business Manager (longa duração).
# Permissões: pages_show_list, pages_read_engagement, pages_read_user_content,
# read_insights, business_management
FB_ACCESS_TOKEN=

# Uma página por conexão. O conector deriva o Page Access Token a partir do token acima.
FB_PAGE_IDS=

# Corte histórico duro (YYYY-MM-DD). Pedido anterior ao limite da plataforma é truncado.
FB_START_DATE=2025-01-01

# Janelas (dias)
FB_LOOKBACK_WINDOW_DAYS=28
FB_COMMENT_WINDOW_DAYS=90

# Versão da Graph API (D24)
FB_API_VERSION=v26.0
